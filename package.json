{
  "name": "tensho-web",
  "private": true,
  "version": "1.0.261102-4",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/.bin/vite",
    "build": "tsc -b && node ./node_modules/.bin/vite build && node scripts/verify-asset-delivery.mjs",
    "build:ios": "tsc -b && node ./node_modules/.bin/vite build --mode native && node scripts/prepare-native-build.mjs && node ./node_modules/.bin/cap sync ios",
    "ios:open": "node ./node_modules/.bin/cap open ios",
    "lint": "oxlint",
    "preview": "node ./node_modules/.bin/vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "sloc": "node scripts/sloc.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:release": "node --test scripts/deployment-versioning.test.mjs scripts/illustration-delivery.test.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:acceptance": "playwright test e2e/app.spec.ts e2e/play-structure.spec.ts e2e/shop.spec.ts e2e/consumables.spec.ts e2e/run-results.spec.ts e2e/classic-resume.spec.ts e2e/two-actions.spec.ts e2e/progress-reset.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@react-spring/web": "^10.1.2",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.3.3"
}
