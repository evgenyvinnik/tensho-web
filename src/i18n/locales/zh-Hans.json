    "welcome": {
      "title": "欢迎来到天翔！",
      "content": "天翔是一款基于日本立直麻将的肉鸽游戏。你的目标是组成高分牌型，达到每局的目标分数。"
    },
    "tiles": {
      "title": "麻将牌",
      "content1": "有三种基本花色：万子（萬）、筒子（筒）和索子（索），每种从1到9编号。"
    },
    "honors": {
      "title": "字牌",
      "content": "字牌包括风牌（东、南、西、北）和三元牌（白、发、中）。字牌不能组成顺子，只能组成刻子。"
    },
    "hands": {
      "title": "组牌",
      "content1": "一副和牌由4个面子加1个对子组成。",
      "content2": "面子可以是顺子（1-2-3）或刻子（3-3-3）。"
    },
    "yaku": {
      "title": "役 - 得分牌型",
      "content1": "役是能够倍增分数的特殊牌型。每个役有1-4级。",
      "content2": "例如：断幺九（无幺九牌）、对对和、清一色（单一花色）。"
    },
    "decrees": {
      "title": "法令 - 规则修改",
      "content1": "法令是能够修改规则并提高分数的特殊卡牌。",
      "content2": "在回合之间的茶寮（商店）收集强力法令。"
    },
    "scoring": {
      "title": "计分公式",
      "formula": "得分 = (基础分 + 奖励) × 倍率",
      "content": "每局达到目标分数即可晋级。幕数越高，需要的分数越多！"
    },
