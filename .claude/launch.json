{
  "version": "0.0.1",
  "autoPort": false,
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5290",
        "--strictPort"
      ],
      "port": 5290
    },
    {
      "name": "e2e",
      "runtimeExecutable": "./node_modules/.bin/vite",
      "runtimeArgs": [
        "--mode",
        "test",
        "--host",
        "127.0.0.1",
        "--port",
        "4273",
        "--strictPort"
      ],
      "port": 4273
    },
    {
      "name": "prod",
      "runtimeExecutable": "./node_modules/.bin/vite",
      "runtimeArgs": [
        "preview",
        "--host",
        "127.0.0.1",
        "--port",
        "4373",
        "--strictPort"
      ],
      "port": 4373
    }
  ]
}
