# App builds only (`vite build --mode native`, run by `bun run build:ios` and
# `bun run build:android`).
# AdMob interstitial shown after every second Boss (src/native/adBreaks.ts).
# Its App ID is GADApplicationIdentifier in ios/App/App/Info.plist.
VITE_ADMOB_INTERSTITIAL_IOS=ca-app-pub-8390307424416403/1457347976
# Android shows Google's test ads until this is set. Its App ID is
# com.google.android.gms.ads.APPLICATION_ID in
# android/app/src/main/AndroidManifest.xml; change both together.
# VITE_ADMOB_INTERSTITIAL_ANDROID=
